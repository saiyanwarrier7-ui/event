# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing and verifying user authentication tokens
JWT_SECRET="nexustech-secure-jwt-production-secret-key-2026"

# SUPABASE CONFIGURATION (Optional: If connecting to a remote Supabase instance)
# 1. Create a project at https://supabase.com
# 2. Execute the migrations provided in supabase_schema.sql
# 3. Supply your project URL and keys below:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
